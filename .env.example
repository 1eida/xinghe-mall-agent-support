# 默认 Mock：规则客服，无需模型 API Key。
# 改为 qwen 并填写 DASHSCOPE_API_KEY 后使用真实千问；auto 按是否配置 Key 选择。
CUSTOMER_SUPPORT_MODE=mock
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 本地服务和文字客服页面。
HOST=127.0.0.1
PORT=8080
AGENT_URL=http://127.0.0.1:8080
AUTH_SECRET=
LOG_LEVEL=INFO

# 会话 checkpoint 与订单/工单分别持久化；Docker Compose 会覆盖为容器路径。
SQLITE_DB_PATH=data/checkpoints.db
CUSTOMER_SUPPORT_DB_PATH=data/customer_support.db

# 政策文档：data/policies/customer_service_policy.md
# Chroma 索引：data/chroma/；BGE 模型缓存：data/models/（首次政策检索自动下载）。
